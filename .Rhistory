df4 <- data.frame(stage = c("Visitors", "Signups", "Trials", "Purchases"),value = c(1000, 600, 300, 120))
df4 <- df4 %>% mutate(stage = factor(stage, levels = rev(stage)))  # reverse order for funnel
ggplot(df4, aes(x = stage, y = value)) +geom_bar(stat = "identity", width = 0.6, fill = "steelblue") +coord_flip() +
theme_minimal() +labs(title = "Funnel Chart", x = "Stage", y = "Count")
fig1
